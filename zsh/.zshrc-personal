}

# ----------------------------------
#
amon() {
  local baudrate="${1:-115200}"
  local lines
  local ports
  local labels
  local selected
  local choice
  local count
  local line
  local port
  local label
  local i

  lines=(${(f)"$(arduino-cli board list --format json 2>/dev/null | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)

for detected in data.get("detected_ports", []):
    port = detected.get("port", {})
    address = port.get("address")
    if not address:
        continue

    boards = detected.get("matching_boards") or []
    if not boards:
        continue

    names = []
    for board in boards:
        name = board.get("name")
        if name and name not in names:
            names.append(name)

    label = ", ".join(names) if names else port.get("protocol_label", "Serial Port")
    print(address + "\t" + label)
' 2>/dev/null)"})

  if [ "${#lines}" -eq 0 ]; then
    for port in /dev/cu.usb* /dev/tty.usb*; do
      [ -e "$port" ] || continue
      lines+=("${port}"$'\t'"Serial Port (USB)")
    done
  fi

  ports=()
  labels=()
  for line in "${lines[@]}"; do
    port="${line%%$'\t'*}"
    label="${line#*$'\t'}"
    ports+=("$port")
    labels+=("$label")
  done

  count=${#ports}

  if [ "$count" -eq 0 ]; then
    echo "No Arduino-compatible serial boards found."
    return 1
  fi

  echo "Available boards:"
  for i in {1..$count}; do
    echo "$i) ${ports[$i]} - ${labels[$i]}"
  done

  echo -n "Choose board [1-$count]: "
  read -r choice

  if ! [[ "$choice" =~ '^[0-9]+$' ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
    echo "Invalid choice."
    return 1
  fi

  selected="${ports[$choice]}"

  echo "Using port: $selected"
  echo "Using baudrate: $baudrate"

  arduino-cli monitor -p "$selected" --config baudrate="$baudrate"
}
