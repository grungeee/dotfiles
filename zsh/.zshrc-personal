function esp32() {
    local port="$1"
    local directory="$2"
    if [ -z "$1" ]; then
        port="ACM0"
    fi
    arduino-cli compile -p /dev/tty"$port" -b esp32:esp32:esp32 "$directory"
    arduino-cli upload -p /dev/tty"$port" -b esp32:esp32:esp32 "$directory"
}


function esp32c3() {
    local port="$1"
    local directory="$2"
    if [ -z "$1" ]; then
        port="ACM0"
    fi
    arduino-cli compile -p /dev/tty"$port" -b esp32:esp32:esp32c3 "$directory"
    arduino-cli upload -p /dev/tty"$port" -b esp32:esp32:esp32c3 "$directory"
}


