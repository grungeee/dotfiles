# --------------- UNO4 -------------
acuno4(){
  arduino-cli compile -p /dev/ttyACM0 --fqbn arduino:renesas_uno:unor4wifi "$1"
}


auuno4(){
  arduino-cli upload -p /dev/ttyACM0 --fqbn arduino:renesas_uno:unor4wifi "$1"
}

UNO4(){
 acuno4 && auuno4
}

