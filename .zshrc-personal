# --------------- UNO3 -------------
acuno3(){
  arduino-cli compile -p /dev/ttyUSB0 --fqbn arduino:avr:uno "$1"
}


auuno3(){
  arduino-cli upload -p /dev/ttyUSB0 --fqbn arduino:avr:uno "$1"
}

UNO3(){
 acuno3 && auuno3
}

